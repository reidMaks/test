# ==========================================
# Media Stack (arr-suite) Environment Secrets
# ==========================================
# Copy this file to .env on QNAP and fill with real credentials.
# NEVER commit the actual .env file to Git!

# General
TZ=Europe/Kyiv
PUID=0
PGID=0

# qBittorrent
QBITTORRENT_USER=admin
# Raw password for cross-seed client connection
QBITTORRENT_PASSWORD=your_qb_password_here
# PBKDF2 hash for qBittorrent.conf WebUI (generated by qBittorrent or python)
QBITTORRENT_WEBUI_HASH=@ByteArray(...)

# *arr Service API Keys (32-character hex string)
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
LIDARR_API_KEY=your_lidarr_api_key_here
BAZARR_API_KEY=your_bazarr_api_key_here

# Jellyfin & Seerr
JELLYFIN_API_KEY=your_jellyfin_api_key_here
SEERR_API_KEY=your_seerr_api_key_here

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=@your_bot_username
